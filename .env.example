# DeckTerm runtime example for a dedicated server.
#
# For public access, keep DeckTerm bound to localhost and expose it through
# Cloudflare Tunnel or a reverse proxy. Use HOST=0.0.0.0 only for a trusted LAN
# or a private dev VM.

PORT=4174
HOST=127.0.0.1
# Choose one:
#   cloudflare-tunnel  - tunnel only; access enforcement happens at the
#                        Cloudflare edge (Application policies). Server-side
#                        JWT validation is OFF.
#   cloudflare-access  - tunnel + DeckTerm validates the Cf-Access JWT itself
#                        (requires CF_ACCESS_TEAM_NAME and CF_ACCESS_AUD).
#   nginx | local | direct - other deployment shapes.
DECKTERM_PUBLISH_MODE=cloudflare-tunnel

TMUX_BACKEND=1
TMUX_SESSION_NAMESPACE=deckterm

OPENCODE_WEB_DEBUG=0
OPENCODE_WEB_MAX_TERMINALS=10
MAX_TERMINALS_PER_USER=10
# Session reapers. Both are off by default: closing a tab with the X is what
# ends a session, and a quiet terminal is not an abandoned one. Set a positive
# value to reap on a timer again (ms here, hours below); 0 or empty means off.
TERMINAL_IDLE_TIMEOUT_MS=0
DECKTERM_ORPHAN_TTL_HOURS=0
SCROLLBACK_MAX_LINES=2000
SCROLLBACK_MAX_BYTES=1048576
DECKTERM_STATE_DIR=/home/deploy/.deckterm
DECKTERM_TASK_MAX_ROUNDS=5
DECKTERM_TASK_PROVIDERS=codex,claude

# B6 retention (docs/upgrade-and-backup-runbook.md §7): daily prune of
# terminal events + ended sessions past TTL, weekly WAL checkpoint. Set
# DECKTERM_RETENTION_DISABLED=1 to turn the scheduler off entirely.
DECKTERM_EVENT_RETENTION_DAYS=30
DECKTERM_SESSION_RETENTION_DAYS=30
# `state`-kind events are replay-only metadata with their own short TTL
# (applies to live sessions too — bounds weeks-running agent terminals).
DECKTERM_STATE_EVENT_RETENTION_DAYS=2
# DECKTERM_RETENTION_DISABLED=1
# Max ended sessions in GET /api/terminals (recent history in the sessions
# drawer); DB retention is unaffected. 0 lists active sessions only.
DECKTERM_TERMINAL_LIST_ENDED_LIMIT=10
# How many backup sets scripts/backup-state.sh keeps.
DECKTERM_BACKUP_KEEP=7

# B7 per-user terminal-create rate limit (per 60s window by default); the
# global backstop defaults to 4x the per-user value.
# TERMINAL_RATE_LIMIT_PER_USER_MAX=40
# TERMINAL_RATE_LIMIT_GLOBAL_MAX=160

# Multiuser enablement gate (B3 §1.6). B2 will implement actual OS
# isolation; until then this only makes startup refuse (fail-closed) when
# unreviewed legacy wildcard grants, unreviewed admins, or no owner exist.
# Leave =0 for single-tenant installs.
DECKTERM_OS_ISOLATION=0

# Restrict file and git APIs to these roots.
ALLOWED_FILE_ROOTS=/home/deploy

# Required only for DECKTERM_PUBLISH_MODE=cloudflare-access (or legacy
# DECKTERM_PUBLISH_MODE=cloudflare). For cloudflare-tunnel keep =0 and rely
# on Cloudflare Access policies at the edge.
CF_ACCESS_REQUIRED=0
# Fill these only when CF_ACCESS_REQUIRED=1.
# CF_ACCESS_TEAM_NAME=your-team-name
# CF_ACCESS_AUD=your-cloudflare-access-application-aud
TRUSTED_ORIGINS=https://deckterm.example.com
