def systemd_run_scope(cfg, unit, profile, token):
    props = []
    for key, val in profile.get("properties", {}).items():
        props += ["--property=%s=%s" % (key, val)]
    runtime_max = profile.get("runtime_max_sec")
    if runtime_max:
        props += ["--property=RuntimeMaxSec=%s" % runtime_max]
    return [
        systemd_run_path(cfg), "--scope", "--collect", "--quiet",
        "--unit=%s" % unit,
    ] + props + ["--", SELF_PATH, "__drop", "--token", token]


def do_spawn(cfg, args, is_exec):
    if not SESSION_RE.match(args.session or ""):
        die("bad --session")
    gc_stale_units(cfg)
    pw, groups = resolve_and_check_identity(cfg, args.username, args.uid, args.gid)

    if not os.path.isabs(args.cwd):
        die("--cwd must be absolute")
    cwd = os.path.realpath(args.cwd)

    profile = get_profile(cfg, args.profile)
    kind = profile.get("kind")

    # A tmux subcommand that would START the per-user server (the FIRST
    # new-session/start-server for this uid) runs in the per-user server scope;
    # everything else — control ops AND subsequent new-sessions once the server
    # is already up — connects to the running server in an anonymous scope.
    tmuxsrv_unit = "deckterm-tmuxsrv-%d.scope" % pw.pw_uid
    wants_server = (
        kind == "tmux"
        and args.profile_args
        and args.profile_args[0] in ("new-session", "start-server")
    )
    server_already_up = wants_server and scope_active(cfg, tmuxsrv_unit)
    starts_server = wants_server and not server_already_up

    if starts_server:
        unit = tmuxsrv_unit
    else:
        unit = "deckterm-%s.scope" % args.session

    # tmux socket-path safety (design §3.5, inv 10): the socket lives in the
    # (untrusted) user's home. The server-starting op ensures+verifies the dirs;
    # every connect (control op OR a new-session joining an existing server)
    # verifies the dirs AND that the socket is a real user-owned socket, not a
    # planted symlink/file redirecting the client to a foreign server.
    if kind == "tmux":
        if starts_server:
            ensure_socket_dirs(pw)
        else:
            assert_socket_dirs_safe(pw)
            assert_socket_type_safe(user_socket_path(cfg, pw))
        # A new-session (first or subsequent) always provisions its own capture
        # dir; start-server has no pane to capture.
        if args.profile_args and args.profile_args[0] == "new-session":
            provision_capture_dir(cfg, args.session, pw.pw_uid)

    argv = assemble_argv(
        cfg, profile, pw, cwd, args.cols, args.rows, args.profile_args, args.session
    )
    # For tmux ops that aren't the server-spawning ones, run in an anonymous
    # per-invocation scope (no persistent unit) so they end with the client.
    if kind == "tmux" and unit.startswith("deckterm-%s" % args.session):
        unit = "deckterm-%s-%s.scope" % (args.session, secrets.token_hex(4))

    # cwd model. PTY/tmux/fs run in `cwd` (chdir post-drop). git/search instead
    # take a granted ROOT + a relative subdir and resolve it fd-safely BENEATH the
    # root as the dropped user (B4 §3/§4, D-B4-5) — a symlinked/swapped component
    # cannot redirect the tool outside the root. The server passes the granted root
    # as --cwd and the subdir as --reldir.
    record_extra = {}
    if kind in ("git", "search"):
        reldir = args.reldir if args.reldir is not None else ""
        # Validate reldir as a contained relative path (empty ⇒ the root itself).
        # Reject empty/'.'/'..' segments so the recorded contract is strict and
        # auditable (Codex S2 quality note); `cwd` (already realpath-canonical, not
        # raw args.cwd) is the root so the fd walk and git's ceiling agree (S2 #3).
        if reldir.startswith("/") or "\x00" in reldir:
            die("--reldir must be relative and NUL-free")
        if reldir != "":
            for seg in reldir.split("/"):
                if seg in ("", ".", ".."):
                    die("--reldir segment not allowed: %r" % reldir)
        record_extra = {"cwd_mode": "fd_beneath", "root_abs": cwd,
                        "reldir": reldir}
        if kind == "git":
            child_env = build_git_env(cfg, pw, cwd)
        else:
            child_env = build_child_env(cfg, pw, args.cols, args.rows)
            child_env["LC_ALL"] = "C"
            child_env["PATH"] = "/usr/bin:/bin"
            child_env.pop("COLUMNS", None)
            child_env.pop("LINES", None)
    else:
        child_env = build_child_env(cfg, pw, args.cols, args.rows)
    token = write_drop_record(
        cfg, args.session, unit, pw, args.gid, groups, cwd, argv, child_env,
        profile.get("nofile"), extra=record_extra,
    )

    _log(verb="exec" if is_exec else "spawn", session=args.session,
         uid=pw.pw_uid, username=pw.pw_name, profile=args.profile,
         unit=unit, verdict="allow")

    cmd = systemd_run_scope(cfg, unit, profile, token)
    os.execv(cmd[0], cmd)  # absolute path; replace self; scope runs on our stdio


def _fchdir_beneath_root(root_abs, reldir):
    """As the dropped user, open the granted root by a component-wise O_NOFOLLOW
    walk from '/' (every ancestor fstat'd a real dir — no symlink swap), then walk
    the relative subdir the same way, and fchdir into the result. A symlinked or
    non-directory component anywhere ⇒ refuse. This is the git/search analogue of
    the fs helper's fd-based containment (B4 §3, D-B4-5).

    Scope (Codex S2 #2/#4): this bounds where the tool STARTS, and git runs with
    hooks/pager/fsmonitor/ext-diff/textconv/global-config execution neutralized, so
    the primary root-escape-via-config vectors are closed. But `fchdir` is not a
    chroot: after it, git/grep do ordinary path resolution as the mapped uid, so
    the hard boundary B4 guarantees is CROSS-UID isolation (Alice's uid cannot
    reach Bob's files). Fine-grained root containment WITHIN one uid (a subdir grant
    that a determined repo config could still read around) is best-effort in 1.0;
    a mount-namespace/chroot boundary is the 1.1 container work (B1 D1)."""
    if not os.path.isabs(root_abs):
        die("root_abs must be absolute")
    segs = [s for s in os.path.normpath(root_abs).split("/") if s]
    if not segs:
        die("root_abs must not be the filesystem root")
    segs += [s for s in reldir.split("/") if s]
    dirfd = os.open("/", os.O_PATH | os.O_DIRECTORY)
    try:
        for seg in segs:
            if seg in (".", ".."):
                die("unsafe cwd segment")
            try:
                nfd = os.open(
                    seg, os.O_PATH | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=dirfd
                )
            except OSError as exc:
                die("cwd_unsafe: %s (%s)" % (seg, os.strerror(exc.errno)))
            os.close(dirfd)
            dirfd = nfd
        try:
            os.fchdir(dirfd)
        except OSError as exc:
            die("fchdir failed: %s" % exc)
    finally:
        os.close(dirfd)


def do_drop(cfg, token):
    record = read_consume_drop_record(cfg, token)
    uid = int(record["uid"])
    gid = int(record["gid"])
    username = record["username"]
    groups = [int(g) for g in record.get("groups", [])]
    cwd = record["cwd"]
    argv = list(record["argv"])
    env = dict(record["env"])
    expected_unit = record["unit"]

    # Re-resolve identity inside the scope (Codex #4): the account must STILL map
    # to the recorded uid/gid. Closes the validation→drop TOCTOU where the
    # account was renamed / UID-reused between record creation and here. We drop
    # to the recorded NUMERIC uid/gid/groups regardless, but refuse if the name
    # no longer resolves to them (drift while the request was in flight).
    try:
        pw_now = pwd.getpwnam(username)
    except KeyError:
        die("identity_drift: %r no longer resolves in __drop" % username)
    if pw_now.pw_uid != uid or pw_now.pw_gid != gid:
        die("identity_drift: %r now uid=%d gid=%d (record uid=%d gid=%d)"
            % (username, pw_now.pw_uid, pw_now.pw_gid, uid, gid))

    # Prove we're inside the broker-created scope, not invoked standalone
    # (Codex #3): the scope's unit name must be a PATH COMPONENT of our cgroup
    # (a full "/<unit>" segment, not a loose substring) — a direct
    # `sudo broker __drop` runs outside any deckterm scope and fails here.
    try:
        with open("/proc/self/cgroup", "r") as fh:
            cgroup = fh.read()
    except OSError as exc:
        die("cannot read cgroup: %s" % exc)
    components = set()
    for line in cgroup.strip().splitlines():
        # format: hierarchy-id:controllers:/path
        path = line.split(":", 2)[-1]
        components.update(seg for seg in path.split("/") if seg)
    if expected_unit not in components:
        die("cgroup mismatch: %r not a component of %r" % (expected_unit, cgroup.strip()))

    # Load libc by soname through the dynamic linker (ld.so cache) — NOT
    # ctypes.util.find_library("c"), which shells out to gcc/ld/objdump via
    # PATH as root (Codex #1).
    libc = ctypes.CDLL("libc.so.6", use_errno=True)

    # Do not retain capabilities across setuid; forbid new privileges.
    if libc.prctl(PR_SET_KEEPCAPS, 0, 0, 0, 0) != 0:
        die("prctl(KEEPCAPS,0) failed")

    # Install the EXACT numeric supplementary set validated at check time
    # (Codex #3) — never os.initgroups(username, …), whose NSS re-enumeration
    # could differ from what eligibility saw and add a privileged/service gid.
    # The record's set already excludes the primary gid duplication concern; add
    # gid to be explicit and drop any accidental 0.
    want_groups = sorted(set(groups) | {gid})
    if 0 in want_groups:
        die("refusing to install group 0 in supplementary set")
    try:
        os.setgroups(want_groups)
    except OSError as exc:
        die("setgroups failed: %s" % exc)
    try:
        os.setgid(gid)
        os.setuid(uid)
    except OSError as exc:
        die("setgid/setuid failed: %s" % exc)

    if libc.prctl(PR_SET_NO_NEW_PRIVS, 1, 0, 0, 0) != 0:
        die("prctl(NO_NEW_PRIVS,1) failed")

    # Post-drop identity + capability + group assertion (Codex #3/#4):
    # getresuid==uid is necessary but not sufficient — a leftover cap set would
    # allow re-escalation, and an unexpected supplementary group would widen
    # reach beyond what eligibility validated.
    assert_dropped_identity(uid, gid, want_groups)

    # rlimits from the record's profile were applied via scope properties where
    # possible; apply NOFILE here (scopes don't take Limit*).
    nofile = record.get("nofile")
    if nofile:
        try:
            resource.setrlimit(resource.RLIMIT_NOFILE, (int(nofile), int(nofile)))
        except (ValueError, OSError):
            pass

    # Controlling terminal (fd 0 = PTY slave handed by the server). Only claim
    # it when the slave has NO controlling session yet — probe with TIOCGSID,
    # which errors (ENOTTY) precisely when the tty is nobody's controlling
    # terminal. A fresh slave ⇒ we setsid + TIOCSCTTY so the shell gets full
    # job control; a slave whose session an outer layer already established
    # (e.g. the server/Bun PTY setup) ⇒ inherit it, since a post-drop
    # unprivileged process cannot steal another session's ctty (Codex note:
    # ioctl failure aborts — but only in the genuine fresh-slave case).
    if os.isatty(0):
        has_ctty = True
        try:
            fcntl.ioctl(0, TIOCGSID, struct.pack("i", 0))
        except OSError:
            has_ctty = False
        if not has_ctty:
            os.setsid()
            try:
                fcntl.ioctl(0, termios.TIOCSCTTY, 0)
            except OSError as exc:
                die("TIOCSCTTY failed: %s" % exc)

    # cwd. git/search resolve their working dir fd-safely BENEATH the granted root
    # as the now-dropped user (B4 §3/§4) — a symlinked/swapped component cannot
    # redirect the tool outside the root. Everything else chdir's to the recorded
    # cwd (already validated/realpath'd pre-drop).
    if record.get("cwd_mode") == "fd_beneath":
        _fchdir_beneath_root(record["root_abs"], record.get("reldir", ""))
    else:
        try:
            os.chdir(cwd)
        except OSError as exc:
            die("chdir(%r) failed as user: %s" % (cwd, exc))

    # Close every fd above stderr before handing control to the untrusted child
    # (Codex #2): systemd-run or the interpreter may have left a privileged fd
    # open, which os.execve would otherwise leak into the mapped-user shell/tmux.
    # fds 0/1/2 (the server-owned PTY / pipes) are deliberately preserved.
    try:
        max_fd = os.sysconf("SC_OPEN_MAX")
    except (ValueError, OSError):
        max_fd = 4096
    os.closerange(3, max_fd)

    os.execve(argv[0], argv, env)


def assert_dropped_identity(uid, gid, want_groups):
    ruid, euid, suid = os.getresuid()
    rgid, egid, sgid = os.getresgid()
    if not (ruid == euid == suid == uid):
        die("uid not fully dropped: %r" % ((ruid, euid, suid),))
    if not (rgid == egid == sgid == gid):
        die("gid not fully dropped: %r" % ((rgid, egid, sgid),))
    # Supplementary groups must be EXACTLY the validated set (Codex #3) — no
    # extra (privileged/service) gid leaked in, none of the intended dropped.
    actual_groups = set(os.getgroups())
    if actual_groups != set(want_groups):
        die("supplementary groups mismatch: have %r want %r"
            % (sorted(actual_groups), want_groups))
    caps = {}
    with open("/proc/self/status", "r") as fh:
        for line in fh:
            if line.startswith(("CapInh:", "CapPrm:", "CapEff:", "CapAmb:")):
                key, val = line.split(":", 1)
                caps[key] = int(val.strip(), 16)
    for key in ("CapInh", "CapPrm", "CapEff", "CapAmb"):
        if caps.get(key, -1) != 0:
            die("capability %s not zero: %x" % (key, caps.get(key, -1)))


def do_kill(cfg, args):
    d = _registry_ready(cfg)
    if args.tmux_server:
        if args.uid is None or int(args.uid) <= 0:
            die("bad --uid for --tmux-server")
        unit = "deckterm-tmuxsrv-%d.scope" % int(args.uid)
    else:
        if not SESSION_RE.match(args.session or ""):
            die("bad --session")
        unit_path = os.path.join(d, "unit-" + args.session + ".json")
        try:
            with open(unit_path, "r") as fh:
                unit = json.load(fh)["unit"]
        except (OSError, ValueError, KeyError):
            # No registry entry — nothing to kill; treat as success (idempotent).
            _log(verb="kill", session=args.session, verdict="noop")
            return 0
    if not unit.startswith("deckterm-") or not unit.endswith(".scope"):
        die("refusing to stop non-deckterm unit: %r" % unit)
    _log(verb="kill", unit=unit, verdict="allow")
    systemctl = systemctl_path(cfg)
    rc = os.spawnv(os.P_WAIT, systemctl, [systemctl, "stop", unit])
    try:
        if not args.tmux_server:
            os.unlink(os.path.join(d, "unit-" + args.session + ".json"))
    except OSError:
        pass
    return 0 if rc == 0 else 0  # stop of an already-gone unit is not an error


def do_check(cfg):
    # Packaging already asserted in main(); verify systemd + config reachability.
    # Absolute paths only (Codex #1) — no PATH search.
    if not os.access(systemd_run_path(cfg), os.X_OK):
        die("systemd-run not executable: %s" % systemd_run_path(cfg), code=1)
    if not os.access(systemctl_path(cfg), os.X_OK):
        die("systemctl not executable: %s" % systemctl_path(cfg), code=1)
    try:
        int(cfg["service_uid"])
    except (KeyError, ValueError):
        die("config missing/invalid service_uid", code=1)
    _registry_ready(cfg)
    sys.stdout.write("ok\n")
    return 0


def build_parser():
    p = argparse.ArgumentParser(prog="deckterm-broker", add_help=False)
    sub = p.add_subparsers(dest="verb", required=True)

    for verb in ("spawn", "exec"):
        s = sub.add_parser(verb, add_help=False)
        s.add_argument("--session", required=True)
        s.add_argument("--username", required=True)
        s.add_argument("--uid", type=int, required=True)
        s.add_argument("--gid", type=int, required=True)
        s.add_argument("--cwd", required=True)
        s.add_argument("--reldir", default=None)  # git/search: subdir beneath cwd
        s.add_argument("--profile", required=True)
        s.add_argument("--cols", type=int, default=120)
        s.add_argument("--rows", type=int, default=30)
        s.add_argument("profile_args", nargs="*")

    k = sub.add_parser("kill", add_help=False)
    k.add_argument("--session")
    k.add_argument("--tmux-server", dest="tmux_server", action="store_true")
    k.add_argument("--uid", type=int)

    sub.add_parser("check", add_help=False)

    dr = sub.add_parser("__drop", add_help=False)
    dr.add_argument("--token", required=True)
    return p


def main(argv):
    load_config()
    # __drop runs INSIDE the scope (already re-execed); it still runs as root
    # until it drops, and must pass packaging too.
    assert_packaging()

    args = build_parser().parse_args(argv)

    if args.verb == "__drop":
        # Keep stdio (PTY); only sanitize env, do not close fds 0-2.
        os.umask(0o022)
        do_drop(_CONFIG, args.token)
        return 0  # unreachable (execve)

    if args.verb in ("spawn", "exec"):
        # spawn keeps stdio (PTY handed by server); close only >2.
        sanitize_process()
        do_spawn(_CONFIG, args, is_exec=(args.verb == "exec"))
        return 0  # unreachable (execvp)

    sanitize_process()
    if args.verb == "kill":
        return do_kill(_CONFIG, args)
    if args.verb == "check":
        return do_check(_CONFIG)
    die("unknown verb")


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
